@@ -0,0 +1,45 @@
+//go:build with_gvisor && linux
+
+package tun
+
+import (
+	"testing"
+	"time"
+
+	"github.com/sagernet/gvisor/pkg/tcpip/link/fdbased"
+	"golang.org/x/sys/unix"
+)
+
+func TestLinkEndpointFilterDetachStopsFDBasedReceiver(t *testing.T) {
+	fds, err := unix.Socketpair(unix.AF_UNIX, unix.SOCK_DGRAM|unix.SOCK_NONBLOCK, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unix.Close(fds[0])
+	defer unix.Close(fds[1])
+	endpoint, err := fdbased.New(&fdbased.Options{FDs: []int{fds[0]}, MTU: 1500, ProcessorsPerChannel: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Always release the real receiver even when the filter's detach is broken.
+	defer endpoint.Attach(nil)
+	filter := &LinkEndpointFilter{LinkEndpoint: endpoint}
+	filter.Attach(&detachTestDispatcher{})
+	if !endpoint.IsAttached() {
+		t.Fatal("receiver was not attached")
+	}
+	done := make(chan struct{})
+	go func() { filter.Attach(nil); close(done) }()
+	select {
+	case <-done:
+	case <-time.After(2 * time.Second):
+		t.Fatal("detach did not wake and join the idle receiver")
+	}
+	if endpoint.IsAttached() {
+		t.Fatal("filter detach left the real fd receiver attached")
+	}
+	// The borrowed FD must still be owned by the caller after detach.
+	if _, err := unix.FcntlInt(uintptr(fds[0]), unix.F_GETFD, 0); err != nil {
+		t.Fatalf("detach closed the caller's fd: %v", err)
+	}
+}
