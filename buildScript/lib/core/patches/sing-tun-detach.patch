--- /dev/null
+++ b/stack_gvisor_filter_detach_test.go
@@ -0,0 +1,50 @@
+//go:build with_gvisor
+
+package tun
+
+import (
+	"net/netip"
+	"testing"
+
+	"github.com/sagernet/gvisor/pkg/tcpip/stack"
+)
+
+type detachRecordingEndpoint struct {
+	stack.LinkEndpoint
+	received []stack.NetworkDispatcher
+}
+
+func (e *detachRecordingEndpoint) Attach(d stack.NetworkDispatcher) {
+	e.received = append(e.received, d)
+}
+
+type detachTestDispatcher struct{ stack.NetworkDispatcher }
+
+func TestLinkEndpointFilterDetachPassesNil(t *testing.T) {
+	endpoint := &detachRecordingEndpoint{}
+	filter := &LinkEndpointFilter{LinkEndpoint: endpoint}
+	filter.Attach(&detachTestDispatcher{})
+	filter.Attach(nil)
+	if len(endpoint.received) != 2 || endpoint.received[1] != nil {
+		t.Fatal("detach must pass a nil interface to the underlying endpoint, not a filter wrapping nil")
+	}
+}
+
+func TestLinkEndpointFilterAttachKeepsFiltering(t *testing.T) {
+	endpoint := &detachRecordingEndpoint{}
+	dispatcher := &detachTestDispatcher{}
+	forwarder := &ForwardDispatcher{}
+	broadcast := netip.MustParseAddr("192.0.2.255")
+	address := netip.MustParseAddr("192.0.2.1")
+	filter := &LinkEndpointFilter{LinkEndpoint: endpoint, BroadcastAddress: broadcast,
+		Dispatcher: forwarder, Inet4Address: address}
+	filter.Attach(dispatcher)
+	if len(endpoint.received) != 1 {
+		t.Fatal("expected one attach")
+	}
+	wrapped, ok := endpoint.received[0].(*networkDispatcherFilter)
+	if !ok || wrapped.NetworkDispatcher != dispatcher || wrapped.dispatcher != forwarder ||
+		wrapped.broadcastAddress != broadcast || wrapped.inet4Address != address {
+		t.Fatal("normal attach must retain packet filtering and its dispatcher/address settings")
+	}
+}
