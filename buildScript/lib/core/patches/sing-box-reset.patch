+	"github.com/sagernet/sing-box/adapter/outbound"
+	boxService "github.com/sagernet/sing-box/adapter/service"
+	"github.com/sagernet/sing-box/dns"
+	"github.com/sagernet/sing-box/dns/transport/local"
+	"github.com/sagernet/sing-box/option"
+)
+
+type failingStartService struct {
+	closeErr   error
+	closePanic bool
+	closes     int
+}
+
+func (*failingStartService) Name() string                   { return "failed-start-test" }
+func (*failingStartService) Start(adapter.StartStage) error { return errors.New("test start failure") }
+func (s *failingStartService) Close() error {
+	s.closes++
+	if s.closePanic {
+		panic("test close panic")
+	}
+	return s.closeErr
+}
+
+func TestStartFailureCleanupConfirmation(t *testing.T) {
+	for _, tc := range []struct {
+		name       string
+		closeErr   error
+		closePanic bool
+	}{
+		{name: "successful"},
+		{name: "failed", closeErr: errors.New("test close failure")},
+		{name: "panicked", closePanic: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			transports := dns.NewTransportRegistry()
+			local.RegisterTransport(transports)
+			ctx := Context(context.Background(), inbound.NewRegistry(), outbound.NewRegistry(), endpoint.NewRegistry(), transports, boxService.NewRegistry(), certificate.NewRegistry())
+			instance, err := New(Options{Context: ctx, Options: option.Options{Log: &option.LogOptions{Disabled: true}}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			fixture := &failingStartService{closeErr: tc.closeErr, closePanic: tc.closePanic}
+			instance.internalService = append(instance.internalService, fixture)
+			if completed, _ := instance.StartFailureCleanupResult(); completed {
+				t.Fatal("cleanup confirmed before Start")
+			}
+			startErr := instance.Start()
+			if startErr == nil {
+				t.Fatal("expected Start failure")
+			}
+			if fixture.closes != 1 {
+				t.Fatalf("automatic closes = %d", fixture.closes)
+			}
+			completed, closeErr := instance.StartFailureCleanupResult()
+			if completed != !tc.closePanic || !errors.Is(closeErr, tc.closeErr) {
+				t.Fatalf("cleanup result = %v, %v; want completed=%v, error=%v", completed, closeErr, !tc.closePanic, tc.closeErr)
+			}
+			if err := instance.Close(); !errors.Is(err, os.ErrClosed) {
+				t.Fatalf("ordinary repeated Close changed semantics: %v", err)
+			}
+		})
+	}
+}
