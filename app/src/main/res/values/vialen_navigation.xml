<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="vialen_navigation_width">280dp</dimen>
    <style name="Widget.Vialen.DrawerItem" parent="Widget.Vialen.NavigationButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:checkable">true</item>
        <item name="android:saveEnabled">false</item>
        <item name="android:textColor">@color/navigation_icon</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="backgroundTint">@color/vialen_navigation_item</item>
        <item name="iconTint">@color/vialen_navigation_icon</item>
        <item name="iconSize">22dp</item>
        <item name="iconPadding">14dp</item>
        <item name="iconGravity">start</item>
        <item name="cornerRadius">@dimen/vialen_pearl_node_corner</item>
        <item name="rippleColor">@color/vialen_ripple</item>
        <item name="strokeWidth">0dp</item>
        <item name="toggleCheckedStateOnClick">false</item>
    </style>
    <style name="Widget.Vialen.DrawerSection" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">24dp</item>
        <item name="android:layout_marginEnd">24dp</item>
        <item name="android:minHeight">24dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textAppearance">@style/TextAppearance.Vialen.Secondary</item>
        <item name="android:textColor">@color/vialen_text_secondary</item>
    </style>
</resources>
