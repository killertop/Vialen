<resources>
    <!-- Base application theme. -->
    <style name="Theme.SagerNet" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="actionBarStyle">@style/Widget.MaterialComponents.ActionBar.Solid</item>
        <item name="actionModeCloseDrawable">@drawable/ic_navigation_close</item>
        <item name="colorButtonNormal">?colorAccent</item>
        <item name="android:navigationBarColor">?colorPrimaryDark</item>
        <item name="colorPrimary">@color/color_ng_black_primary</item>
        <item name="colorPrimaryDark">@color/color_ng_black_primary</item>
        <item name="colorAccent">@color/color_ng_black_accent</item>

        <item name="colorMaterial100">@color/color_ng_black_primary</item>
        <item name="colorMaterial300">@color/color_ng_black_primary</item>

        <item name="accentOrTextSecondary">?android:textColorSecondary</item>
        <item name="accentOrTextPrimary">?android:textColorPrimary</item>
        <item name="primaryOrTextSecondary">?android:textColorSecondary</item>
        <item name="primaryOrTextPrimary">?android:textColorPrimary</item>

        <item name="fabColorBackground">@color/color_ng_black_accent</item>
        <item name="selectedColorPrimary">@color/color_ng_black_accent</item>
        <item name="actionBarTheme">@style/ThemeOverlay.AppCompat.Dark.ActionBar</item>
        <item name="tabTextColor">#99FFFFFF</item>
        <item name="tabSelectedTextColor">@color/white</item>
        <item name="tabIndicatorColor">@color/white</item>
        <item name="tabRippleColor">@color/white</item>
        <item name="whiteOrTextPrimary">@color/white</item>

        <item name="windowActionModeOverlay">true</item>

        <!-- Remove ActionBar but keep styles and themes -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="chipStyle">@style/Widget.MaterialComponents.Chip.Choice.SagerNet</item>

        <item name="itemShapeAppearance">
            @style/ShapeAppearance.MaterialComponents.MediumComponent
        </item>

        <item name="alertDialogTheme">
            @style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet
        </item>

        <item name="materialAlertDialogTheme">
            @style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet
        </item>

        <item name="itemShapeFillColor">@color/color_ng_black_accent</item>
    </style>

    <style name="Theme.SagerNet.Dialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="actionBarStyle">@style/Widget.MaterialComponents.ActionBar.Solid</item>
        <item name="actionModeCloseDrawable">@drawable/ic_navigation_close</item>
        <item name="colorButtonNormal">?colorAccent</item>
        <item name="android:navigationBarColor">?colorPrimaryDark</item>
        <item name="colorPrimary">@color/color_ng_black_primary</item>
        <item name="colorPrimaryDark">@color/color_ng_black_primary</item>
        <item name="colorAccent">@color/color_ng_black_accent</item>

        <item name="colorMaterial100">@color/color_ng_black_primary</item>
        <item name="colorMaterial300">@color/color_ng_black_primary</item>

        <item name="accentOrTextSecondary">?android:textColorSecondary</item>
        <item name="accentOrTextPrimary">?android:textColorPrimary</item>
        <item name="primaryOrTextSecondary">?android:textColorSecondary</item>
        <item name="primaryOrTextPrimary">?android:textColorPrimary</item>

        <item name="fabColorBackground">@color/color_ng_black_accent</item>
        <item name="selectedColorPrimary">@color/color_ng_black_accent</item>
        <item name="actionBarTheme">@style/ThemeOverlay.AppCompat.Dark.ActionBar</item>
        <item name="tabTextColor">#99FFFFFF</item>
        <item name="tabSelectedTextColor">@color/white</item>
        <item name="tabIndicatorColor">@color/white</item>
        <item name="tabRippleColor">@color/white</item>
        <item name="whiteOrTextPrimary">@color/white</item>

        <item name="windowActionModeOverlay">true</item>

        <!-- Remove ActionBar but keep styles and themes -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="chipStyle">@style/Widget.MaterialComponents.Chip.Choice.SagerNet</item>

        <item name="itemShapeAppearance">
            @style/ShapeAppearance.MaterialComponents.MediumComponent
        </item>

        <item name="alertDialogTheme">
            @style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet
        </item>

        <item name="materialAlertDialogTheme">
            @style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet
        </item>

        <item name="windowFixedHeightMajor" type="dimen">95%</item>

        <item name="itemShapeFillColor">@color/color_ng_black_accent</item>
    </style>

    <style name="AppearanceFoundation.Title" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet">
        <item name="buttonBarPositiveButtonStyle">
            @style/Widget.MaterialComponents.Button.TextButton.Dialog.Primary
        </item>
        <item name="buttonBarNegativeButtonStyle">
            @style/Widget.MaterialComponents.Button.TextButton.Dialog.Primary
        </item>
        <item name="buttonBarNeutralButtonStyle">
            @style/Widget.MaterialComponents.Button.TextButton.Dialog.Flush.Primary
        </item>
    </style>

    <style name="Widget.MaterialComponents.Button.TextButton.Dialog.Primary">
        <item name="android:textColor">?primaryOrTextPrimary</item>
    </style>

    <style name="Widget.MaterialComponents.Button.TextButton.Dialog.Flush.Primary">
        <item name="android:textColor">?primaryOrTextPrimary</item>
    </style>

    <style name="Widget.MaterialComponents.Chip.Choice.SagerNet">
        <item name="textStartPadding">30dp</item>
        <item name="textEndPadding">30dp</item>
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="android:textColor">@color/chip_text_color</item>
        <item name="checkedIconTint">?primaryOrTextPrimary</item>
        <item name="rippleColor">@color/chip_ripple_color</item>
    </style>

    <style name="Theme.SagerNet.Black">
        <item name="colorPrimary">@color/color_ng_black_primary</item>
        <item name="colorPrimaryDark">@color/color_ng_black_primary</item>
        <item name="colorAccent">@color/color_ng_black_accent</item>
        <item name="colorMaterial100">@color/color_ng_black_primary</item>
        <item name="colorMaterial300">@color/color_ng_black_primary</item>

        <item name="selectedColorPrimary">@color/color_ng_black_accent</item>
        <item name="fabColorBackground">@color/color_ng_black_accent</item>
        <item name="itemShapeFillColor">@color/color_ng_black_accent</item>

        <item name="accentOrTextSecondary">?android:textColorSecondary</item>
        <item name="accentOrTextPrimary">?android:textColorPrimary</item>
        <item name="primaryOrTextSecondary">?android:textColorSecondary</item>
        <item name="primaryOrTextPrimary">?android:textColorPrimary</item>
    </style>

    <style name="Theme.SagerNet.Dialog.Black">
        <item name="colorPrimary">@color/color_ng_black_primary</item>
        <item name="colorPrimaryDark">@color/color_ng_black_primary</item>
        <item name="colorAccent">@color/color_ng_black_accent</item>
        <item name="colorMaterial100">@color/color_ng_black_primary</item>
        <item name="colorMaterial300">@color/color_ng_black_primary</item>

        <item name="selectedColorPrimary">@color/color_ng_black_accent</item>
        <item name="fabColorBackground">@color/color_ng_black_accent</item>
        <item name="itemShapeFillColor">@color/color_ng_black_accent</item>

        <item name="accentOrTextSecondary">?android:textColorSecondary</item>
        <item name="accentOrTextPrimary">?android:textColorPrimary</item>
        <item name="primaryOrTextSecondary">?android:textColorSecondary</item>
        <item name="primaryOrTextPrimary">?android:textColorPrimary</item>
    </style>

    <style name="Theme.Start" parent="Theme.MaterialComponents.DayNight">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorPrimary">@android:color/transparent</item>
        <item name="colorPrimaryDark">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

</resources>