<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <include layout="@layout/layout_appbar" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <androidx.core.widget.NestedScrollView android:background="@android:color/transparent" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:padding="16dp">
                <ImageView android:layout_width="72dp" android:layout_height="72dp" android:src="@mipmap/ic_launcher" android:importantForAccessibility="no" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/app_name" android:textAppearance="?attr/textAppearanceHeadline5" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="@string/app_desc" android:textColor="@color/vialen_text_secondary" android:textAppearance="@style/TextAppearance.Vialen.Secondary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/brand_version" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:textAllCaps="false" android:contentDescription="@string/ui_copy_version" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="@string/ui_about_support" android:textColor="@color/vialen_text_category" android:textAppearance="@style/TextAppearance.Vialen.Section" />
            <com.google.android.material.card.MaterialCardView style="@style/Widget.Vialen.PearlCard" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/brand_help" style="@style/Widget.Vialen.NavigationButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="start|center_vertical" android:textAllCaps="false" android:textColor="@color/vialen_text_primary" android:text="@string/ui_help" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/brand_releases" style="@style/Widget.Vialen.NavigationButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="start|center_vertical" android:textAllCaps="false" android:textColor="@color/vialen_text_primary" android:text="@string/ui_updates" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/brand_feedback" style="@style/Widget.Vialen.NavigationButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="start|center_vertical" android:textAllCaps="false" android:textColor="@color/vialen_text_primary" android:text="@string/ui_feedback" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="@string/ui_about_transparency" android:textColor="@color/vialen_text_category" android:textAppearance="@style/TextAppearance.Vialen.Section" />
            <com.google.android.material.card.MaterialCardView style="@style/Widget.Vialen.PearlCard" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/brand_source" style="@style/Widget.Vialen.NavigationButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="start|center_vertical" android:textAllCaps="false" android:textColor="@color/vialen_text_primary" android:text="@string/ui_source" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/brand_licenses" style="@style/Widget.Vialen.NavigationButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="start|center_vertical" android:textAllCaps="false" android:textColor="@color/vialen_text_primary" android:text="@string/ui_licenses" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/brand_credits" style="@style/Widget.Vialen.NavigationButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="start|center_vertical" android:textAllCaps="false" android:textColor="@color/vialen_text_primary" android:text="@string/ui_credits" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
