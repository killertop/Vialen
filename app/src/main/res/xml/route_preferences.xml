<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <EditTextPreference app:key="routeName" app:title="@string/route_name" app:useSimpleSummaryProvider="true" />
    <moe.matsuri.nb4a.ui.EditConfigPreference app:key="serverConfig" app:title="@string/custom_config" app:useSimpleSummaryProvider="true" />
    <PreferenceCategory app:title="@string/ui_match_conditions">
        <io.nekohasekai.sagernet.widget.AppListPreference app:key="routePackages" app:title="@string/apps" />
        <EditTextPreference app:key="routeDomain" app:title="@string/ui_rule_domain" app:useSimpleSummaryProvider="true" />
        <EditTextPreference app:key="routeIP" app:title="@string/ui_rule_destination_ip" app:useSimpleSummaryProvider="true" />
        <EditTextPreference android:layout_width="match_parent" android:layout_height="match_parent" app:key="routePort" app:title="@string/ui_rule_destination_port" app:useSimpleSummaryProvider="true" />
        <EditTextPreference app:key="routeSource" app:title="@string/ui_rule_source_ip" app:useSimpleSummaryProvider="true" />
        <EditTextPreference app:key="routeSourcePort" app:title="@string/ui_rule_source_port" app:useSimpleSummaryProvider="true" />
        <moe.matsuri.nb4a.ui.SimpleMenuPreference app:entries="@array/route_protocol_entry" app:entryValues="@array/route_protocol_value" app:key="routeNetwork" app:title="@string/ui_rule_network" app:useSimpleSummaryProvider="true" />
        <EditTextPreference app:key="routeProtocol" app:title="@string/ui_rule_protocol" app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/ui_rule_action">
        <io.nekohasekai.sagernet.widget.OutboundPreference app:key="routeOutbound" app:title="@string/ui_rule_action" app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>
</PreferenceScreen>
