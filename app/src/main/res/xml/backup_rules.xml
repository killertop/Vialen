<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="FullBackupContent">
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="rule-sets/" />
        <include
            domain="database"
            path="vialen_profiles.db" />
        <include
            domain="database"
            path="vialen_preferences.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="rule-sets/" />
        <include
            domain="database"
            path="vialen_profiles.db" />
        <include
            domain="database"
            path="vialen_preferences.db" />
    </device-transfer>
</data-extraction-rules>
