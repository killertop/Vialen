{
  "dns": {
    "final": "dns-remote",
    "rules": [
      {
        "domain": [
          "ss.baseline.internal"
        ],
        "server": "dns-direct"
      },
      {
        "outbound": [
          "any"
        ],
        "server": "dns-direct"
      },
      {
        "action": "evaluate",
        "domain_suffix": [
          "cn"
        ],
        "rule_set": [
          "geosite-cn"
        ],
        "server": "dns-remote"
      },
      {
        "action": "route",
        "mode": "and",
        "rules": [
          {
            "domain_suffix": [
              "cn"
            ],
            "rule_set": [
              "geosite-cn"
            ]
          },
          {
            "ip_is_private": true,
            "match_response": true,
            "rule_set": [
              "geoip-cn"
            ]
          }
        ],
        "server": "dns-direct",
        "type": "logical"
      },
      {
        "action": "reject",
        "rule_set": [
          "geosite-category-ads-all"
        ]
      }
    ],
    "servers": [
      {
        "detour": "direct",
        "tag": "dns-local",
        "type": "local"
      },
      {
        "detour": "direct",
        "domain_resolver": "dns-local",
        "server": "223.5.5.5",
        "tag": "dns-direct",
        "type": "udp"
      },
      {
        "domain_resolver": "dns-direct",
        "server": "8.8.8.8",
        "tag": "dns-remote",
        "type": "tls"
      }
    ],
    "strategy": "prefer_ipv4"
  },
  "endpoints": [],
  "http_clients": [
    {
      "detour": "direct",
      "tag": "default-http-client"
    }
  ],
  "inbounds": [
    {
      "address": [
        "172.19.0.1/28",
        "fdfe:dcba:9876::1/126"
      ],
      "endpoint_independent_nat": true,
      "mtu": 1500,
      "stack": "gvisor",
      "tag": "tun-in",
      "type": "tun"
    },
    {
      "listen": "127.0.0.1",
      "listen_port": 2080,
      "tag": "mixed-in",
      "type": "mixed"
    }
  ],
  "log": {
    "level": "info"
  },
  "outbounds": [
    {
      "domain_strategy": "prefer_ipv4",
      "method": "chacha20-ietf-poly1305",
      "password": "mypassword",
      "server": "ss.baseline.internal",
      "server_port": 8388,
      "tag": "proxy",
      "type": "shadowsocks"
    },
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "tag": "bypass",
      "type": "direct"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_http_client": "default-http-client",
    "rule_set": [
      {
        "format": "binary",
        "http_client": "default-http-client",
        "tag": "geoip-cn",
        "type": "remote",
        "update_interval": "24h",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs"
      },
      {
        "format": "binary",
        "http_client": "default-http-client",
        "tag": "geosite-category-ads-all",
        "type": "remote",
        "update_interval": "24h",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-category-ads-all.srs"
      },
      {
        "format": "binary",
        "http_client": "default-http-client",
        "tag": "geosite-cn",
        "type": "remote",
        "update_interval": "24h",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-cn.srs"
      }
    ],
    "rules": [
      {
        "action": "sniff"
      },
      {
        "action": "hijack-dns",
        "port": [
          53
        ]
      },
      {
        "action": "hijack-dns",
        "protocol": [
          "dns"
        ]
      },
      {
        "domain_suffix": [
          "cn"
        ],
        "ip_is_private": true,
        "outbound": "bypass",
        "rule_set": [
          "geoip-cn"
        ]
      },
      {
        "action": "reject",
        "rule_set": [
          "geosite-category-ads-all"
        ]
      },
      {
        "action": "reject",
        "ip_cidr": [
          "224.0.0.0/3",
          "ff00::/8"
        ],
        "source_ip_cidr": [
          "224.0.0.0/3",
          "ff00::/8"
        ]
      }
    ]
  }
}
